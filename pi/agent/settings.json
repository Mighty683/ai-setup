{
  "subagents": {
    "modelScope": {
      "enforce": true,
      "allow": [
        "openai-codex/*"
      ]
    },
    "watchdog": {
      "enabled": true,
      "agentEndTimeoutMs": 120000,
      "main": {
        "enabled": true,
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high"
      },
      "children": {
        "enabled": true,
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high",
        "autoFollow": {
          "blockers": false,
          "maxAttempts": 2,
          "stalemateRepeats": 2
        }
      },
      "scope": {
        "enabled": true
      },
      "cadence": {
        "everyNTools": null
      },
      "autoFollow": {
        "blockers": false,
        "maxAttempts": 2,
        "stalemateRepeats": 2
      },
      "asyncCompletion": {
        "enabled": false,
        "autoFollowBlockers": false
      },
      "lsp": {
        "enabled": true,
        "timeoutMs": 5000,
        "maxFiles": 30,
        "maxDiagnostics": 100
      }
    },
    "agentOverrides": {
      "coordinator": {
        "defaultContext": "fork"
      },
      "claude-code": {
        "disabled": true
      },
      "claude-code-writer": {
        "disabled": true
      },
      "codex-exec": {
        "disabled": true
      },
      "codex-exec-writer": {
        "disabled": true
      },
      "cursor-agent": {
        "disabled": true
      },
      "cursor-agent-writer": {
        "disabled": true
      },
      "reviewer": {
        "disabled": true
      },
      "oracle": {
        "disabled": true
      }
    }
  },
  "lastChangelogVersion": "0.84.3",
  "enabledModels": [
    "gpt-5.6-sol",
    "gpt-5.6-terra",
    "gpt-5.6-luna"
  ],
  "packages": [
    "npm:pi-subagents@0.58.0",
    "npm:pi-intercom@0.12.0",
    "npm:pi-mcp-adapter@2.30.0",
    "npm:pi-lens@4.1.2",
    "npm:pi-web-access@0.26.0",
    "npm:@benvargas/pi-openai-fast@1.1.0"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-terra",
  "defaultThinkingLevel": "medium",
  "theme": "dark"
}
