{
  "npmCommand": ["pnpm", "--config.save-exact=true"],
  "subagents": {
    "worktree": false,
    "maxSubagentDepth": 4,
    "modelScope": {
      "enforce": true,
      "allow": [
        "openai-codex/*"
      ]
    },
    "agentOverrides": {
      "coordinator": {
        "defaultContext": "fresh"
      },
      "claude-code": {
        "disabled": true
      },
      "claude-code-writer": {
        "disabled": true
      },
      "codex-exec": {
        "disabled": true
      },
      "codex-exec-writer": {
        "disabled": true
      },
      "cursor-agent": {
        "disabled": true
      },
      "cursor-agent-writer": {
        "disabled": true
      }
    }
  },
  "lastChangelogVersion": "0.85.1",
  "enabledModels": [
    "gpt-6-astra",
    "gpt-6-sol",
    "gpt-6-luna",
    "gpt-5.6-terra"
  ],
  "packages": [
    "npm:pi-subagents@0.74.0",
    "npm:pi-intercom@0.16.0",
    "npm:pi-mcp-adapter@5.0.0",
    "npm:pi-lens@4.3.0",
    "npm:pi-web-access@0.35.0",
    "npm:@benvargas/pi-openai-fast@1.1.1",
    "npm:pi-interview@0.13.0"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-sol",
  "defaultThinkingLevel": "high",
  "theme": "dark"
}
